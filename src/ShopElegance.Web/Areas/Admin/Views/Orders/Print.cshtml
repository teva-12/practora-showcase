@model ShopElegance.Core.DTOs.OrderDto
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Order @Model.OrderNumber — Packing Slip</title>
    <style>
        body { font-family: Arial, Helvetica, sans-serif; color: #1a1a1a; padding: 40px; max-width: 850px; margin: 0 auto; }
        h1 { font-size: 1.4rem; margin-bottom: 4px; }
        .muted { color: #6b7280; font-size: 0.85rem; }
        table { width: 100%; border-collapse: collapse; margin-top: 16px; }
        th, td { text-align: left; padding: 8px 6px; border-bottom: 1px solid #e5e7eb; font-size: 0.82rem; vertical-align: top; }
        th { color: #6b7280; text-transform: uppercase; font-size: 0.68rem; letter-spacing: 0.05em; }
        .header-row { display: flex; justify-content: space-between; border-bottom: 2px solid #1a1a1a; padding-bottom: 16px; margin-bottom: 20px; }
        .addr-grid { display: flex; justify-content: space-between; margin-bottom: 16px; }
        .customization-box { font-size: 0.75rem; color: #374151; margin-top: 6px; padding: 8px; background: #f9fafb; border-radius: 4px; }
        .print-btn { margin-bottom: 20px; }
        .status-badge { display: inline-block; padding: 4px 12px; border-radius: 20px; background: #eef2ff; font-size: 0.75rem; font-weight: 600; }
        @@media print { .print-btn { display: none; } }
    </style>
</head>
<body>
    <div class="print-btn"><button onclick="window.print()">🖨 Print</button></div>

    <div class="header-row">
        <div>
            <h1>Packing Slip — @Model.OrderNumber</h1>
            <p class="muted">Placed @Model.CreatedAt.ToString("MMMM d, yyyy 'at' HH:mm")</p>
        </div>
        <div style="text-align:right">
            <span class="status-badge">@Model.Status</span>
            <p class="muted" style="margin-top:6px">Payment: @Model.PaymentMethod (@Model.PaymentStatus)</p>
        </div>
    </div>

    <div class="addr-grid">
        <div>
            <strong style="font-size:0.85rem">Ship To</strong>
            <p class="muted">
                @Model.ShippingAddress.FirstName @Model.ShippingAddress.LastName<br />
                @Model.ShippingAddress.AddressLine1<br />
                @if (!string.IsNullOrEmpty(Model.ShippingAddress.AddressLine2))
                {
                    @:@Model.ShippingAddress.AddressLine2<br />
                }
                @Model.ShippingAddress.City, @Model.ShippingAddress.State<br />
                @Model.ShippingAddress.Country<br />
                @Model.ShippingAddress.Phone
            </p>
        </div>
        <div style="text-align:right">
            <strong style="font-size:0.85rem">Customer</strong>
            <p class="muted">@Model.CustomerName<br />@Model.CustomerEmail</p>
        </div>
    </div>

    <table>
        <thead>
            <tr><th>Item</th><th>SKU</th><th>Qty</th></tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>
                        <strong>@item.ProductName</strong>
                        @if (item.Customization != null)
                        {
                            <div class="customization-box">
                                <div style="margin-bottom:6px">
                                    <strong>Fit:</strong> @item.Customization.CoatType | @item.Customization.Size | @item.Customization.Fabric | @item.Customization.Color
                                </div>
                                @if (item.Customization.EmbroideryEnabled)
                                {
                                    <div style="margin-bottom:6px">
                                        <strong>Embroidery:</strong> @(item.Customization.StudentName ?? item.Customization.DoctorName)
                                        @if (!string.IsNullOrEmpty(item.Customization.Faculty)) { <span> · @item.Customization.Faculty</span> }
                                        @if (!string.IsNullOrEmpty(item.Customization.Department)) { <span> · @item.Customization.Department</span> }
                                        @if (item.Customization.GraduationYear.HasValue) { <span> · Class of @item.Customization.GraduationYear</span> }
                                        <br />
                                        <small>Font: @item.Customization.EmbroideryFontName | Pos: @item.Customization.EmbroideryPosition | Color: @item.Customization.EmbroideryTextColor</small>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(item.Customization.LogoType))
                                {
                                    <div style="margin-bottom:6px">
                                        <strong>Logo:</strong> @item.Customization.LogoType
                                        @{
                                            var previewUrl = item.Customization.LogoImageUrl ?? item.Customization.CustomLogoUrl;
                                        }
                                        @if (!string.IsNullOrEmpty(previewUrl))
                                        {
                                            <div style="margin-top:4px"><img src="@previewUrl" alt="Logo" style="width:60px; height:60px; object-fit:contain; border:1px solid #e5e7eb; padding:2px;" /></div>
                                        }
                                    </div>
                                }
                                @if (item.Customization.RequiresSpecialPackaging || item.Customization.IsFragile)
                                {
                                    <div style="color:#b45309">
                                        <strong>⚠️ Shipping Extras:</strong>
                                        @if (item.Customization.RequiresSpecialPackaging) { <span>Special Packaging Required</span> }
                                        @if (item.Customization.RequiresSpecialPackaging && item.Customization.IsFragile) { <span> | </span> }
                                        @if (item.Customization.IsFragile) { <span>Fragile Item</span> }
                                    </div>
                                }
                            </div>
                        }
                    </td>
                    <td>@(item.ProductSKU ?? "—")</td>
                    <td>@item.Quantity</td>
                </tr>
            }
        </tbody>
    </table>

    @if (!string.IsNullOrEmpty(Model.Notes))
    {
        <p class="muted" style="margin-top:16px"><strong>Notes:</strong> @Model.Notes</p>
    }
</body>
</html>
