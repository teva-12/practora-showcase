@model ShopElegance.Core.DTOs.CreateCategoryDto
@{
    ViewData["Title"] = "Add Category";
}

<div class="breadcrumb">
    <a asp-action="Index">Categories</a><span>›</span><span>Add Category</span>
</div>
<div class="page-header">
    <h1 class="page-title">Add Category</h1>
    <div class="page-actions">
        <a asp-action="Index" class="btn btn-secondary">← Cancel</a>
        <button type="submit" form="catForm" class="btn btn-primary">Save Category</button>
    </div>
</div>

<div style="max-width:640px">
    <form asp-action="Create" method="post" id="catForm">
        <div class="content-card">
            <div class="content-card-body">
                <div asp-validation-summary="All" class="alert alert-danger"
                     style="display:@(ViewData.ModelState.IsValid?"none":"block")"></div>

                <div class="form-group">
                    <label asp-for="Name">Name *</label>
                    <input asp-for="Name" class="form-control" placeholder="e.g. Electronics" />
                    <span asp-validation-for="Name" class="field-validation-error"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Description">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="3"
                              placeholder="Short category description"></textarea>
                </div>
                <div class="form-group">
                    <label asp-for="ParentCategoryId">Parent Category</label>
                    <select asp-for="ParentCategoryId" class="form-control">
                        <option value="">None (Top Level)</option>
                        @if (ViewBag.ParentCategories is IEnumerable<ShopElegance.Core.DTOs.CategoryDto> parents)
                        {
                            @foreach (var p in parents)
                            {
                                <option value="@p.Id">@p.Name</option>
                            }
                        }
                    </select>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="SortOrder">Sort Order</label>
                        <input asp-for="SortOrder" class="form-control" type="number" min="0" value="0" />
                    </div>
                    <div class="form-group" style="display:flex;align-items:flex-end;padding-bottom:18px">
                        <div class="form-check">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" checked />
                            <label asp-for="IsActive">Active</label>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label asp-for="ImageUrl">Image URL (optional)</label>
                    <input asp-for="ImageUrl" class="form-control" placeholder="/images/categories/electronics.jpg" />
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
