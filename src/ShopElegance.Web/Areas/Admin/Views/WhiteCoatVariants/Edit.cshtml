@model ShopElegance.Core.DTOs.UpdateWhiteCoatVariantDto
@{
    ViewData["Title"] = "Edit White Coat Variant";
    var products = ViewBag.Products as IEnumerable<ShopElegance.Core.DTOs.ProductListDto> ?? Enumerable.Empty<ShopElegance.Core.DTOs.ProductListDto>();
    var images = ViewBag.Images as IEnumerable<ShopElegance.Core.DTOs.WhiteCoatVariantImageDto> ?? Enumerable.Empty<ShopElegance.Core.DTOs.WhiteCoatVariantImageDto>();
    int variantId = ViewBag.VariantId;
}

<div class="breadcrumb">
    <a asp-action="Index">White Coat Variants</a><span>›</span><span>Edit Variant</span>
</div>
<div class="page-header">
    <h1 class="page-title">Edit White Coat Variant</h1>
    <div class="page-actions">
        <a asp-action="Index" class="btn btn-secondary">← Cancel</a>
        <button type="submit" form="variantForm" class="btn btn-primary">Save Changes</button>
    </div>
</div>

<form asp-action="Edit" asp-route-id="@variantId" method="post" id="variantForm">
    <div style="display:grid;grid-template-columns:1fr 340px;gap:24px">
        <div>
            <div class="content-card" style="margin-bottom:20px">
                <div class="content-card-header"><span class="content-card-title">Product & Identity</span></div>
                <div class="content-card-body">
                    <div asp-validation-summary="All" class="alert alert-danger" style="display:@(ViewData.ModelState.IsValid?"none":"block")"></div>

                    <div class="form-group">
                        <label asp-for="ProductId">Product *</label>
                        <select asp-for="ProductId" class="form-control">
                            @foreach (var p in products)
                            {
                                <option value="@p.Id" selected="@(p.Id == Model.ProductId)">@p.Name</option>
                            }
                        </select>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label asp-for="SKU">SKU *</label>
                            <input asp-for="SKU" class="form-control" />
                            <span asp-validation-for="SKU" class="field-validation-error"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Barcode">Barcode</label>
                            <input asp-for="Barcode" class="form-control" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-card" style="margin-bottom:20px">
                <div class="content-card-header"><span class="content-card-title">Variant Attributes</span></div>
                <div class="content-card-body">
                    <div class="form-row">
                        <div class="form-group">
                            <label asp-for="CoatType">Coat Type *</label>
                            <select asp-for="CoatType" class="form-control">
                                @foreach (var c in new[] { "Normal", "Zip" })
                                {
                                    <option value="@c" selected="@(c == Model.CoatType)">@(c == "Zip" ? "بسوسته" : c)</option>
                                }
                            </select>
                        </div>
                        <div class="form-group">
                            <label asp-for="Size">Size *</label>
                            <select asp-for="Size" class="form-control">
                                @foreach (var s in new[] { "Medium", "Large", "X-Large", "2X-Large", "3X-Large" })
                                {
                                    <option value="@s" selected="@(s == Model.Size)">@s</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label asp-for="Color">Color *</label>
                            <input asp-for="Color" class="form-control" value="White" readonly />
                        </div>
                        <div class="form-group">
                            <label asp-for="Fabric">Fabric *</label>
                            <select asp-for="Fabric" class="form-control">
                                @foreach (var f in new[] { "Cotton", "Regular" })
                                {
                                    <option value="@f" selected="@(f == Model.Fabric)">@f</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-card">
                <div class="content-card-header"><span class="content-card-title">Images</span></div>
                <div class="content-card-body">
                    <div class="image-preview-grid" style="margin-bottom:16px">
                        @if (!images.Any())
                        {
                            <p style="font-size:0.875rem;color:var(--text-muted)">No images uploaded yet.</p>
                        }
                        @foreach (var img in images)
                        {
                            <div style="position:relative;display:inline-block;margin:0 8px 8px 0">
                                <img src="@img.Url" alt="@img.AltText" style="width:100px;height:100px;object-fit:cover;border-radius:6px;border:1px solid var(--border)" />
                                @if (img.IsPrimary)
                                {
                                    <span class="status-pill status-delivered" style="position:absolute;top:4px;left:4px;font-size:0.65rem">Primary</span>
                                }
                                <form asp-action="RemoveImage" method="post" style="position:absolute;top:4px;right:4px"
                                      onsubmit="return confirm('Remove this image?')">
                                    <input type="hidden" name="variantId" value="@variantId" />
                                    <input type="hidden" name="imageId" value="@img.Id" />
                                    <button type="submit" class="btn btn-danger btn-sm" style="padding:2px 6px;font-size:0.7rem">✕</button>
                                </form>
                            </div>
                        }
                    </div>
                    <form asp-action="UploadImage" method="post" enctype="multipart/form-data" style="display:flex;gap:8px;align-items:center">
                        <input type="hidden" name="variantId" value="@variantId" />
                        <input type="file" name="file" accept="image/*" class="form-control" style="flex:1" />
                        <label style="display:flex;align-items:center;gap:6px;font-size:0.875rem;white-space:nowrap">
                            <input type="checkbox" name="isPrimary" value="true" /> Set as primary
                        </label>
                        <button type="submit" class="btn btn-outline btn-sm">Upload</button>
                    </form>
                </div>
            </div>
        </div>

        <div>
            <div class="content-card" style="margin-bottom:20px">
                <div class="content-card-header"><span class="content-card-title">Pricing & Stock</span></div>
                <div class="content-card-body">
                    <div class="form-group">
                        <label asp-for="PriceAdjustment">Price Adjustment ($)</label>
                        <input asp-for="PriceAdjustment" class="form-control" type="number" step="0.01" min="0" />
                    </div>
                    <div class="form-group">
                        <label asp-for="Weight">Weight (kg)</label>
                        <input asp-for="Weight" class="form-control" type="number" step="0.01" min="0" />
                    </div>
                    <div class="form-group">
                        <label asp-for="StockQuantity">Stock Quantity *</label>
                        <input asp-for="StockQuantity" class="form-control" type="number" min="0" />
                        <span asp-validation-for="StockQuantity" class="field-validation-error"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="LowStockThreshold">Low Stock Threshold</label>
                        <input asp-for="LowStockThreshold" class="form-control" type="number" min="0" />
                    </div>
                    <div class="form-check">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                        <label asp-for="IsActive">Active (available for purchase)</label>
                    </div>
                </div>
            </div>

            <div class="content-card">
                <div class="content-card-header"><span class="content-card-title">Danger Zone</span></div>
                <div class="content-card-body">
                    <form asp-action="Delete" asp-route-id="@variantId" method="post"
                          onsubmit="return confirm('Delete this variant permanently?')">
                        <button type="submit" class="btn btn-danger" style="width:100%">Delete Variant</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
}
