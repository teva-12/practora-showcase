@model ShopElegance.Core.DTOs.CreateCouponDto
@{
    ViewData["Title"] = "Add Coupon";
}

<div class="breadcrumb"><a asp-action="Index">Coupons</a><span>›</span><span>Add Coupon</span></div>
<div class="page-header">
    <h1 class="page-title">Add Coupon</h1>
    <div class="page-actions">
        <a asp-action="Index" class="btn btn-secondary">← Cancel</a>
        <button type="submit" form="couponForm" class="btn btn-primary">Save Coupon</button>
    </div>
</div>

<div style="max-width:640px">
    <form asp-action="Create" method="post" id="couponForm">
        <div class="content-card">
            <div class="content-card-body">
                <div asp-validation-summary="All" class="alert alert-danger"
                     style="display:@(ViewData.ModelState.IsValid?"none":"block")"></div>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="Code">Coupon Code *</label>
                        <input asp-for="Code" class="form-control" placeholder="SUMMER25"
                               style="font-family:monospace;text-transform:uppercase;letter-spacing:0.05em" />
                        <span asp-validation-for="Code" class="field-validation-error"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Type">Discount Type *</label>
                        <select asp-for="Type" class="form-control">
                            <option value="Percentage">Percentage (%)</option>
                            <option value="FixedAmount">Fixed Amount ($)</option>
                        </select>
                    </div>
                </div>
                <div class="form-group">
                    <label asp-for="Description">Description (optional)</label>
                    <input asp-for="Description" class="form-control" placeholder="e.g. 25% off summer sale" />
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="Value">Discount Value *</label>
                        <input asp-for="Value" class="form-control" type="number" step="0.01" min="0" placeholder="e.g. 25" />
                        <span asp-validation-for="Value" class="field-validation-error"></span>
                        <small class="help-text">Use 25 for 25% off, or 20 for $20 off</small>
                    </div>
                    <div class="form-group">
                        <label asp-for="UsageLimit">Usage Limit</label>
                        <input asp-for="UsageLimit" class="form-control" type="number" min="1" placeholder="Leave blank for unlimited" />
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="MinimumOrderAmount">Minimum Order Amount ($)</label>
                        <input asp-for="MinimumOrderAmount" class="form-control" type="number" step="0.01" min="0" placeholder="0.00" />
                    </div>
                    <div class="form-group">
                        <label asp-for="MaximumDiscountAmount">Max Discount ($)</label>
                        <input asp-for="MaximumDiscountAmount" class="form-control" type="number" step="0.01" min="0" placeholder="Leave blank for unlimited" />
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="ExpiresAt">Expiry Date (optional)</label>
                        <input asp-for="ExpiresAt" class="form-control" type="date" />
                    </div>
                    <div class="form-group" style="display:flex;align-items:flex-end;padding-bottom:18px">
                        <div class="form-check">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" checked />
                            <label asp-for="IsActive">Active</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
