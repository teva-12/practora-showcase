@model ShopElegance.Core.DTOs.CreateEmbroideryFontDto
@{
    ViewData["Title"] = "Edit Embroidery Font";
    int fontId = ViewBag.FontId;
}

<div class="breadcrumb">
    <a asp-action="Index">Embroidery Fonts</a><span>›</span><span>Edit Font</span>
</div>
<div class="page-header">
    <h1 class="page-title">Edit Embroidery Font</h1>
    <div class="page-actions">
        <a asp-action="Index" class="btn btn-secondary">← Cancel</a>
        <button type="submit" form="fontForm" class="btn btn-primary">Save Changes</button>
    </div>
</div>

<form asp-action="Edit" asp-route-id="@fontId" method="post" id="fontForm">
    <div class="content-card" style="max-width:600px">
        <div class="content-card-body">
            <div asp-validation-summary="All" class="alert alert-danger" style="display:@(ViewData.ModelState.IsValid?"none":"block")"></div>

            <div class="form-group">
                <label asp-for="Name">Font Name *</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="field-validation-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="CssFontFamily">CSS Font Family *</label>
                <input asp-for="CssFontFamily" class="form-control" />
                <span asp-validation-for="CssFontFamily" class="field-validation-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="PreviewImageUrl">Preview Image URL</label>
                <input asp-for="PreviewImageUrl" class="form-control" />
            </div>
            <div class="form-check">
                <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                <label asp-for="IsActive">Active (available for customers to choose)</label>
            </div>
        </div>
    </div>
</form>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
}
