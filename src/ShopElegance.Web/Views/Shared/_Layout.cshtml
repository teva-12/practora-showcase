<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Practora</title>
    <meta name="description" content="Practora — premium academic uniforms and custom white coats for medical, engineering, and healthcare students." />
    <link rel="icon" href="~/images/P.png" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @Html.AntiForgeryToken()
    <a class="skip-link" href="#mainContent">Skip to main content</a>
    <partial name="_Notifications" />

    <!-- Navigation -->
    <nav class="navbar" id="mainNav" aria-label="Main navigation">
        <div class="container navbar-inner" style="display:flex;align-items:center;justify-content:space-between;height:100%;">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <img src="~/images/P.png" alt="Practora" />
                <span>Practora</span>
            </a>

            <ul class="navbar-nav" id="navMenu">
                <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li><a asp-controller="Shop" asp-action="Index">Shop</a></li>
                <li><a asp-controller="Home" asp-action="Index" asp-fragment="whitecoat-customizer">Design Your White Coat</a></li>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li><a asp-controller="Account" asp-action="Orders">My Orders</a></li>
                }
            </ul>

            <div class="navbar-actions">
                <button type="button" class="btn-icon theme-toggle" id="themeToggle" aria-label="Toggle dark mode">
                    <span class="theme-icon">☀</span>
                </button>

                <button type="button" class="btn-icon" id="searchToggle" aria-label="Search">
                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
                </button>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="btn-icon" asp-controller="Wishlist" asp-action="Index" aria-label="Wishlist" style="position:relative">
                        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                        <span class="cart-badge" id="wishlistCount" style="display:none">0</span>
                    </a>
                }

                <a class="btn-icon" asp-controller="Cart" asp-action="Index" aria-label="Cart" style="position:relative">
                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                    <span class="cart-badge" id="cartCount" style="display:none">0</span>
                </a>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="account-dropdown">
                        <button type="button" class="btn-icon" id="accountMenuToggle" aria-label="My Account" aria-haspopup="true" aria-expanded="false">
                            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                        </button>
                        <div class="account-dropdown-menu" id="accountMenu" role="menu">
                            <a asp-controller="Account" asp-action="Profile" class="account-dropdown-item" role="menuitem">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                                View Profile
                            </a>
                            @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                            {
                                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="account-dropdown-item" role="menuitem">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                                    Admin Panel
                                </a>
                            }
                            <div class="account-dropdown-divider"></div>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="account-dropdown-item account-dropdown-item-danger" role="menuitem">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                                    Log Out
                                </button>
                            </form>
                        </div>
                    </div>
                }
                else
                {
                    <a class="btn btn-outline" style="padding:8px 18px;font-size:0.85rem; position:relative; z-index:10;" asp-controller="Account" asp-action="Login">Sign In</a>
                }

                <button type="button" class="btn-icon" id="navToggler" aria-label="Toggle menu">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="4" y1="6" x2="20" y2="6"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="18" x2="20" y2="18"/></svg>
                </button>
            </div>
        </div>
    </nav>

    <!-- Search Overlay -->
    <div class="search-overlay" id="searchOverlay" role="dialog" aria-modal="true" aria-label="Search products">
        <div class="search-container">
            <form asp-controller="Shop" asp-action="Index" method="get" class="search-form" id="searchForm">
                <input type="text" name="search" id="searchInput" class="search-input" placeholder="Search products..." autocomplete="off">
                <button type="button" class="search-clear" id="searchClear" aria-label="Clear search">✕</button>
                <button type="submit" class="search-btn">Search</button>
                <button type="button" class="search-close" id="searchClose" aria-label="Close search">✕</button>
            </form>
            <div class="search-recent" id="searchRecent" style="display:none">
                <div class="search-recent-label">Recent Searches</div>
                <div class="search-recent-chips" id="searchRecentChips"></div>
            </div>
        </div>
    </div>

    <main id="mainContent">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <div class="footer-grid">
                <div>
                    <div class="footer-brand">✦ Practora</div>
                    <p>Premium academic uniforms and custom white coats for medical, engineering, pharmacy, and healthcare students across Egypt.</p>
                    <div class="footer-social">
                        <a href="https://www.tiktok.com/@@practora" target="_blank" rel="noopener noreferrer" aria-label="TikTok">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12.53.02C13.84 0 15.14.01 16.44 0c.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
                        </a>
                        <a href="https://www.instagram.com/practora.store/?hl=en" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
                        </a>
                        <a href="https://wa.me/201062002729" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.48 1.32 4.99L2 22l5.25-1.38a9.85 9.85 0 0 0 4.79 1.22h.01c5.46 0 9.9-4.45 9.9-9.91C21.95 6.45 17.5 2 12.04 2zm5.8 14.06c-.24.68-1.4 1.32-1.93 1.4-.5.08-1.13.11-1.83-.11a11 11 0 0 1-1.99-.75c-3.5-1.51-5.77-5.03-5.95-5.26-.17-.23-1.42-1.89-1.42-3.6 0-1.72.9-2.56 1.22-2.91.31-.35.68-.44.91-.44h.65c.21 0 .49-.03.76.58s.94 2.27 1.02 2.44c.09.17.14.36.03.58-.12.23-.18.36-.35.55-.17.2-.36.44-.51.6-.17.17-.35.36-.15.7.2.35.9 1.48 1.93 2.4 1.33 1.18 2.44 1.55 2.8 1.72.35.17.55.15.75-.09.21-.23.87-1.01 1.1-1.36.23-.35.46-.29.78-.17s2.02.95 2.37 1.13c.35.17.58.26.66.4.1.15.1.85-.15 1.52z"/></svg>
                        </a>
                        <a href="https://www.facebook.com/share/18BPSyKank/" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H8v-3h2V9.5C10 7.57 11.57 6 13.5 6H16v3h-2c-.55 0-1 .45-1 1v2h3v3h-3v6.95c5.05-.5 9-4.76 9-9.95z"/></svg>
                        </a>
                        <a href="https://www.linkedin.com/company/practora-store" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.38-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45z"/></svg>
                        </a>
                    </div>
                </div>
                <div>
                    <h4>Shop</h4>
                    <ul>
                        <li><a asp-controller="Shop" asp-action="Index">All Products</a></li>
                        <li><a asp-controller="Home" asp-action="Index" asp-fragment="whitecoat-customizer">Design Your White Coat</a></li>
                        <li><a asp-controller="Wishlist" asp-action="Index">Wishlist</a></li>
                        <li><a asp-controller="Cart" asp-action="Index">Cart</a></li>
                    </ul>
                </div>
                <div>
                    <h4>Support</h4>
                    <ul>
                        <li><a asp-controller="Home" asp-action="Privacy">Privacy Policy</a></li>
                        <li><a asp-controller="Account" asp-action="Orders">Track Order</a></li>
                        <li><a href="mailto:support@practora.com">Contact Us</a></li>
                    </ul>
                </div>
                <div>
                    <h4>Account</h4>
                    <ul>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li><a asp-controller="Account" asp-action="Profile">My Profile</a></li>
                            <li><a asp-controller="Account" asp-action="Orders">My Orders</a></li>
                        }
                        else
                        {
                            <li><a asp-controller="Account" asp-action="Login">Sign In</a></li>
                            <li><a asp-controller="Account" asp-action="Register">Create Account</a></li>
                        }
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">
                <span>© @DateTime.Now.Year Practora. All rights reserved.</span>
                <span>Made for students who care about how they show up.</span>
            </div>
        </div>
    </footer>

    <div class="top-loading-bar" id="topLoadingBar"></div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/premium-enhancements.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
