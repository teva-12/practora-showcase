@model ShopElegance.Core.DTOs.ProductListDto

<div class="product-card" data-product-id="@Model.Id">
    <div class="product-img-wrap">
        <a asp-controller="Shop" asp-action="Product" asp-route-slug="@Model.Slug">
            @if (!string.IsNullOrEmpty(Model.PrimaryImageUrl))
            {
                <img src="@Model.PrimaryImageUrl" alt="@Model.Name" class="product-img" loading="lazy" />
            }
            else
            {
                <div class="product-img-placeholder">
                    <span>✦</span>
                </div>
            }
        </a>
        <div class="product-badges">
            @if (Model.DiscountPercentage.HasValue && Model.DiscountPercentage > 0)
            {
                <span class="badge badge-sale">-@Model.DiscountPercentage.Value.ToString("0")%</span>
            }
            @if (!Model.InStock)
            {
                <span class="badge badge-oos">Out of Stock</span>
            }
            @if (Model.ProductType == "Digital")
            {
                <span class="badge badge-digital">Digital</span>
            }
            @if (Model.SalesCount > 20)
            {
                <span class="badge badge-bestseller">★ Bestseller</span>
            }
            else if (Model.IsFeatured)
            {
                <span class="badge badge-new">Featured</span>
            }
        </div>
        <div class="product-actions-overlay">
            <form asp-controller="Cart" asp-action="Add" method="post" class="add-to-cart-form">
                <input type="hidden" name="productId" value="@Model.Id" />
                <input type="hidden" name="quantity" value="1" />
                <button type="submit" class="btn-cart-quick" disabled="@(!Model.InStock)"
                        title="@(Model.InStock ? "Add to Cart" : "Out of Stock")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/></svg>
                    @(Model.InStock ? "Add to Cart" : "Out of Stock")
                </button>
            </form>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <form asp-controller="Wishlist" asp-action="Toggle" method="post" class="wishlist-toggle-form">
                    <input type="hidden" name="productId" value="@Model.Id" />
                    <button type="submit" class="btn-wishlist-quick" title="Add to Wishlist">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                    </button>
                </form>
            }
        </div>
    </div>
    <div class="product-info">
        <span class="product-category">@Model.CategoryName</span>
        <h3 class="product-name">
            <a asp-controller="Shop" asp-action="Product" asp-route-slug="@Model.Slug">@Model.Name</a>
        </h3>
        @if (Model.ReviewCount > 0)
        {
            <div class="product-rating">
                <div class="stars" style="--rating: @Model.AverageRating">★★★★★</div>
                <span class="rating-count">(@Model.ReviewCount)</span>
            </div>
        }
        <div class="product-price">
            <span class="price-current">@Model.Price.ToString("C")</span>
            @if (Model.CompareAtPrice.HasValue)
            {
                <span class="price-original">@Model.CompareAtPrice.Value.ToString("C")</span>
            }
        </div>
    </div>
</div>
