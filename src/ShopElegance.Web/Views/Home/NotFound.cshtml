@{
    ViewData["Title"] = "Page Not Found";
}

<div style="min-height:60vh;display:flex;align-items:center;justify-content:center;padding:48px 24px">
    <div style="text-align:center;max-width:480px">
        <div style="font-size:6rem;font-weight:900;color:var(--border);line-height:1;margin-bottom:16px">404</div>
        <h1 style="font-family:var(--font-serif);font-size:1.8rem;margin-bottom:12px">Page Not Found</h1>
        <p style="color:var(--text-muted);margin-bottom:32px">
            The page you're looking for doesn't exist or has been moved.
        </p>
        <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
            <a asp-controller="Shop" asp-action="Index" class="btn btn-primary">Browse Shop</a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline">← Home</a>
        </div>
    </div>
</div>
