@{
    ViewData["Title"] = "Error";
}

<div style="min-height:60vh;display:flex;align-items:center;justify-content:center;padding:48px 24px">
    <div style="text-align:center;max-width:520px">
        <div style="font-size:5rem;margin-bottom:16px">⚠️</div>
        <h1 style="font-family:var(--font-serif);font-size:2rem;margin-bottom:12px">Something went wrong</h1>
        <p style="color:var(--text-muted);margin-bottom:32px">We're sorry for the inconvenience. Please try again or contact support if the problem persists.</p>
        @if (!string.IsNullOrEmpty(ViewBag.RequestId?.ToString()))
        {
            <p style="font-size:0.75rem;color:var(--text-muted);font-family:monospace;margin-bottom:24px">
                Request ID: @ViewBag.RequestId
            </p>
        }
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">← Back to Home</a>
    </div>
</div>
