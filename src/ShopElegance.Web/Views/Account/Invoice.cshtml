@model ShopElegance.Core.DTOs.OrderDto
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Invoice — @Model.OrderNumber</title>
    <style>
        body { font-family: Arial, Helvetica, sans-serif; color: #1a1a1a; padding: 40px; max-width: 800px; margin: 0 auto; }
        h1 { font-size: 1.4rem; margin-bottom: 4px; }
        .muted { color: #6b7280; font-size: 0.85rem; }
        table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        th, td { text-align: left; padding: 8px 6px; border-bottom: 1px solid #e5e7eb; font-size: 0.85rem; }
        th { color: #6b7280; text-transform: uppercase; font-size: 0.7rem; letter-spacing: 0.05em; }
        .totals { margin-top: 16px; width: 300px; margin-left: auto; }
        .totals div { display: flex; justify-content: space-between; padding: 4px 0; font-size: 0.85rem; }
        .totals .grand { font-weight: 700; font-size: 1rem; border-top: 1px solid #1a1a1a; padding-top: 8px; margin-top: 6px; }
        .header-row { display: flex; justify-content: space-between; align-items: start; border-bottom: 2px solid #1a1a1a; padding-bottom: 16px; margin-bottom: 20px; }
        .customization { font-size: 0.78rem; color: #4b5563; margin-top: 4px; }
        .print-btn { margin-bottom: 20px; }
        @@media print { .print-btn { display: none; } }
    </style>
</head>
<body>
    <div class="print-btn">
        <button onclick="window.print()">🖨 Print / Save as PDF</button>
    </div>

    <div class="header-row">
        <div>
            <h1>Practora</h1>
            <p class="muted">Invoice for Order @Model.OrderNumber</p>
        </div>
        <div style="text-align:right">
            <p class="muted">Date: @Model.CreatedAt.ToString("MMMM d, yyyy")</p>
            <p class="muted">Status: @Model.Status</p>
        </div>
    </div>

    <div style="display:flex;justify-content:space-between;margin-bottom:20px">
        <div>
            <strong style="font-size:0.85rem">Bill To</strong>
            <p class="muted">
                @Model.ShippingAddress.FirstName @Model.ShippingAddress.LastName<br />
                @Model.ShippingAddress.AddressLine1<br />
                @if (!string.IsNullOrEmpty(Model.ShippingAddress.AddressLine2))
                {
                    @:@Model.ShippingAddress.AddressLine2<br />
                }
                @Model.ShippingAddress.City, @Model.ShippingAddress.State<br />
                @Model.ShippingAddress.Country
            </p>
        </div>
        <div style="text-align:right">
            <strong style="font-size:0.85rem">Payment</strong>
            <p class="muted">@Model.PaymentMethod</p>
        </div>
    </div>

    <table>
        <thead>
            <tr><th>Item</th><th>Qty</th><th>Unit Price</th><th>Total</th></tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>
                        @item.ProductName
                        @if (item.Customization != null)
                        {
                            <div class="customization">
                                @if (item.Customization.EmbroideryEnabled)
                                {
                                    @:Embroidered: @(item.Customization.StudentName ?? item.Customization.DoctorName)
                                    @:· @item.Customization.EmbroideryPosition · @item.Customization.EmbroideryFontName
                                }
                                @if (!string.IsNullOrEmpty(item.Customization.LogoType))
                                {
                                    <br />
                                    @:Logo: @item.Customization.LogoType
                                }
                            </div>
                        }
                    </td>
                    <td>@item.Quantity</td>
                    <td>@item.UnitPrice.ToString("C")</td>
                    <td>@item.TotalPrice.ToString("C")</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="totals">
        <div><span>Subtotal</span><span>@Model.SubTotal.ToString("C")</span></div>
        @if (Model.DiscountAmount > 0)
        {
            <div><span>Discount</span><span>-@Model.DiscountAmount.ToString("C")</span></div>
        }
        <div><span>Shipping</span><span>@Model.ShippingCost.ToString("C")</span></div>
        <div><span>Tax</span><span>@Model.TaxAmount.ToString("C")</span></div>
        <div class="grand"><span>Total</span><span>@Model.Total.ToString("C")</span></div>
    </div>

    <p class="muted" style="margin-top:40px;text-align:center">Thank you for your order — Practora</p>
</body>
</html>
