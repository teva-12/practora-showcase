@model ShopElegance.Web.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
}

<div style="padding:40px 0 80px">
    <div class="container">
        <div class="account-layout">
            <aside>
                <nav class="account-nav">
                    <a asp-action="Profile" class="account-nav-item">👤 Profile</a>
                    <a asp-action="Orders" class="account-nav-item">📦 My Orders</a>
                    <a asp-controller="Wishlist" asp-action="Index" class="account-nav-item">♡ Wishlist</a>
                    <a asp-action="ChangePassword" class="account-nav-item active">🔑 Change Password</a>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="account-nav-item">🚪 Log Out</button>
                    </form>
                </nav>
            </aside>
            <div>
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success" data-auto-dismiss>@TempData["SuccessMessage"]</div>
                }
                <div class="account-card">
                    <h2 class="account-card-title">Change Password</h2>
                    <div style="max-width:480px">
                        <form asp-action="ChangePassword" method="post">
                            <div asp-validation-summary="All" class="alert alert-danger"
                                 style="display:@(ViewData.ModelState.IsValid?"none":"block")"></div>

                            <div class="form-group">
                                <label asp-for="CurrentPassword">Current Password</label>
                                <input asp-for="CurrentPassword" class="form-control" type="password" autocomplete="current-password" />
                                <span asp-validation-for="CurrentPassword" class="field-validation-error"></span>
                            </div>
                            <div class="form-group">
                                <label asp-for="NewPassword">New Password</label>
                                <input asp-for="NewPassword" class="form-control" type="password" autocomplete="new-password" />
                                <span asp-validation-for="NewPassword" class="field-validation-error"></span>
                                <small style="color:var(--text-muted);font-size:0.78rem">Min. 8 characters, must include uppercase, number, and symbol.</small>
                            </div>
                            <div class="form-group">
                                <label asp-for="ConfirmPassword">Confirm New Password</label>
                                <input asp-for="ConfirmPassword" class="form-control" type="password" autocomplete="new-password" />
                                <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
                            </div>
                            <button type="submit" class="btn btn-primary">Update Password</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
