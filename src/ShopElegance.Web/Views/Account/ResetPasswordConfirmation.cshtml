@{
    ViewData["Title"] = "Password Reset";
    Layout = "_Layout";
}

<div class="auth-page">
    <div class="auth-card" style="text-align:center">
        <div class="auth-logo"><img src="~/images/practora-logo.png" alt="Practora" style="height: 40px; width: auto;" /></div>
        <div class="empty-icon" style="margin:0 auto 16px">✅</div>
        <h1 class="auth-title">Password reset</h1>
        <p class="auth-subtitle">Your password has been changed successfully. You can now sign in with your new password.</p>

        <div class="form-group-submit">
            <a asp-action="Login" class="btn btn-primary btn-block">Sign In →</a>
        </div>
    </div>
</div>
